@{
    Layout = "_LayoutLogin";
}
@model RegisterViewModel

<form method="post" class="form-horizontal mt-3" asp-action="Register">
    <div asp-validation-summary="ModelOnly" class="text-danger">

    </div>
    <div class="form-group mb-3 row">
        <div class="col-12">
            <input class="form-control" asp-for="UserName" required="" placeholder="Username">
            <span asp-validation-for="UserName" class="text-danger"></span>

        </div>
    </div>

    <div class="form-group mb-3 row">
        <div class="col-12">
            <input class="form-control" asp-for="Password" required="" placeholder="Password">
            <span asp-validation-for="Password" class="text-danger"></span>

        </div>
    </div>

    <div class="form-group mb-3 row">
        <div class="col-12">
            <div class="custom-control custom-checkbox">
                <input class="form-control" asp-for="PasswordConfirmation" required="" placeholder="Password">
               <span asp-validation-for="PasswordConfirmation" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="form-group mb-3 text-center row mt-3 pt-1">
        <div class="col-12">
            <button class="btn btn-info w-100 waves-effect waves-light" type="submit">Register</button>
        </div>
    </div>

</form>
